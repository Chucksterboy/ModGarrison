[
  {
    "id": "bepinex",
    "dependency": {
      "id": "runtime:bepinex",
      "name": "BepInEx Mono x64",
      "provider": "github-release",
      "source": "github-release:BepInEx/BepInEx#BepInEx_win_x64_*.zip",
      "notes": "Official stable BepInEx 5 Windows x64 build for Mono Unity games."
    },
    "profileEngines": ["unity-mono"],
    "profileLoaders": ["bepinex"],
    "providerPackages": [
      {
        "provider": "thunderstore",
        "namespacePatterns": ["*"],
        "packagePatterns": ["BepInEx", "BepInExPack", "BepInExPack_*", "*_BepInExPack"]
      },
      {
        "provider": "nexus",
        "namespacePatterns": [],
        "packagePatterns": ["BepInEx", "BepInEx Pack", "BepInExPack", "BepInExPack *", "BepInEx Pack *"]
      },
      {
        "provider": "gamebanana",
        "namespacePatterns": [],
        "packagePatterns": ["BepInEx", "BepInEx Pack", "BepInExPack", "BepInExPack *", "BepInEx Pack *"]
      },
      {
        "provider": "steam-workshop",
        "namespacePatterns": [],
        "packagePatterns": ["BepInEx", "BepInEx Pack", "BepInExPack", "BepInExPack *", "BepInEx Pack *"]
      },
      {
        "provider": "modio",
        "namespacePatterns": [],
        "packagePatterns": ["BepInEx", "BepInEx Pack", "BepInExPack", "BepInExPack *", "BepInEx Pack *"]
      }
    ],
    "detectionRules": [
      {
        "any": [
          "file:BepInEx/core/BepInEx.dll",
          "file:BepInEx/core/BepInEx.Unity.Mono.dll"
        ]
      },
      {
        "all": [
          "file-name:BepInEx.Unity.Mono.dll",
          "file-name:doorstop_config.ini",
          "file-name:winhttp.dll"
        ]
      },
      {
        "all": [
          "file-name:BepInEx.dll",
          "file-name:doorstop_config.ini",
          "file-name:winhttp.dll"
        ]
      },
      {
        "all": ["dir:BepInEx", "file-name:doorstop_config.ini", "file-name:winhttp.dll"]
      }
    ]
  },
  {
    "id": "bepinex-il2cpp",
