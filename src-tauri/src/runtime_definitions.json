      {
        "provider": "modio",
        "namespacePatterns": [],
        "packagePatterns": ["BepInEx", "BepInEx Pack", "BepInExPack", "BepInExPack *", "BepInEx Pack *"]
      }
    ],
    "detectionRules": [
      {
        "all": [
          "file-name:BepInEx.Unity.IL2CPP.dll",
          "file-name:doorstop_config.ini",
          "file-name:winhttp.dll"
        ]
      },
      {
        "all": [
          "file-name:BepInEx.dll",
          "file-name:doorstop_config.ini",
          "file-name:winhttp.dll",
          "profile-engine:unity-il2cpp"
        ]
      },
      {
        "all": ["file:BepInEx/core/BepInEx.dll", "dir-prefix:BepInEx/interop"]
      },
      {
        "all": ["file:BepInEx/core/BepInEx.dll", "dir:dotnet"]
      },
      {
        "all": ["file:BepInEx/core/BepInEx.dll", "profile-engine:unity-il2cpp"]
      },
      {
        "all": ["file:BepInEx/core/BepInEx.dll", "profile-loader:bepinex-il2cpp"]
      }
    ]
  },
