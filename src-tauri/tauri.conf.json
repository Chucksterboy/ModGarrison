{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mod Garrison",
  "mainBinaryName": "mod-garrison",
  "version": "0.11.0",
  "identifier": "com.modgarrison.desktop",
  "build": {
    "beforeDevCommand": "pnpm vite --host 127.0.0.1",
    "beforeBuildCommand": "pnpm run build:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mod Garrison",
        "width": 1260,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "backgroundColor": "#020609",
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nxm"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "5ba6dfb8-cc1b-520e-b9fc-4ac0cd205de7"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
